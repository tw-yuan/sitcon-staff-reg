# 注意：除了 PORT / BASE_URL / DATABASE_FILE 之外，以下所有設定都「可選」——
# 你可以完全不用 .env，改在網頁後台「系統設定」填寫（存進資料庫）。
# 首次啟動會在 log 印出 setup key，用它到 /admin/login 登入即可開始設定。
# 若同時在 .env 與後台都設定，環境變數為預設、後台設定會覆蓋。

# ---- 基本 ----
# PORT 僅供「非 docker 本機執行」使用（app 監聽埠，預設 3000）。
# docker 下容器固定監聽 3000，對外埠請在 docker-compose.yml 的 ports 設定（目前 9000）；
# 請勿在此設 PORT，否則會被注入容器、與對外埠對應打架。
# PORT=3000
# 對外的完整網址（OAuth callback 會以此組成），結尾不要加斜線；換成你實際對外網址
BASE_URL=http://localhost:9000
# session 加密用，請改成夠長的隨機字串
SESSION_SECRET=please-change-this-to-a-long-random-string
# SQLite 檔案路徑（docker compose 下對應 ./data volume）
DATABASE_FILE=./data/app.db
# 單檔上傳大小上限（MB）
MAX_UPLOAD_MB=10

# ---- Admin allowlist ----
# 可進入 /admin 的行政組 Google 帳號，逗號分隔
ADMIN_EMAILS=alice@sitcon.org,bob@sitcon.org

# ---- OAuth：Google（工人 email + admin 登入）----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- OAuth：GitHub（工人帳號）----
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---- OAuth：GitLab（工人帳號，gitlab.com）----
GITLAB_BASE_URL=https://gitlab.com
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=

# ---- Telegram Login（工人第四個驗證帳號，僅蒐集、不加群）----
# 於 @BotFather 建立 bot 取得 token，並用 /setdomain 設定為 BASE_URL 的網域
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# ---- Google Sheets / Drive（Service Account）----
# 掛載到容器內的 service account 金鑰 JSON 路徑
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=./secrets/service-account.json
# 工人回應要寫入的試算表 ID 與分頁名稱
RESPONSES_SPREADSHEET_ID=
RESPONSES_SHEET_NAME=Responses
# 檔案上傳存放的 Google Drive 資料夾 ID（Sheet 內存連結）
DRIVE_UPLOAD_FOLDER_ID=
# Google Groups 加/移除成員要模擬的 Workspace 管理員信箱（需 domain-wide delegation）
GOOGLE_WORKSPACE_ADMIN_EMAIL=

# ---- Provisioning：GitLab ----
# 具 Owner/Maintainer 權限的 token，用來把工人加入 group/project
GITLAB_TOKEN=

# ---- Email（SMTP）----
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="SITCON 2027 行政組 <no-reply@sitcon.org>"
# 回覆信箱（留空＝以 SMTP_FROM 為回覆對象）
SMTP_REPLY_TO=
# 信件主旨與內文模板改於後台「系統設定 → 信件模板」編輯，不需寫在 .env
